{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "react-native": ["./src/preview/shims/react-native.tsx"],
      "react-native-reanimated": ["./src/preview/shims/reanimated.ts"],
      "@shopify/react-native-skia": ["./src/preview/shims/skia.tsx"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
